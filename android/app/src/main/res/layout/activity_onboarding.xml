<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ben_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/ben_text_primary"
            android:text="@string/onboarding_title" />

        <TextView
            android:id="@+id/onboarding_step_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:textColor="@color/ben_text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_grant_accessibility_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/onboarding_grant_accessibility" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_grant_runtime_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboarding_grant_runtime" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_grant_battery_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboarding_grant_battery" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_oem_autostart_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="@string/onboarding_grant_oem_autostart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_check_offline_lang_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboarding_check_offline_lang" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/onboarding_phrase_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/onboarding_phrase_label"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/onboarding_phrase_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/onboarding_openai_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/onboarding_openai_key_label"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/onboarding_openai_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_scan_qr_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            android:text="@string/onboarding_scan_qr" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_continue_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/onboarding_continue" />

    </LinearLayout>
</ScrollView>
